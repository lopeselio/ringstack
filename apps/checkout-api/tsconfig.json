{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // NestJS uses legacy (experimental) decorators. tsx/esbuild does not emit
    // decorator metadata, so providers are injected with explicit @Inject tokens.
    "experimentalDecorators": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
