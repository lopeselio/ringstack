{
  "name": "@ringstack/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./receipt": "./src/receipt.ts",
    "./receipt-open": "./src/receipt-open.ts",
    "./memo": "./src/memo.ts",
    "./ringpay": "./src/ringpay.ts",
    "./payment-proof": "./src/payment-proof.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx --env-file-if-exists=../../.env scripts/smoke.ts",
    "receipt:e2e": "tsx --env-file-if-exists=../../.env scripts/receipt-e2e.ts",
    "memo:e2e": "tsx --env-file-if-exists=../../.env scripts/memo-e2e.ts",
    "session:e2e": "tsx --env-file-if-exists=../../.env scripts/session-e2e.ts",
    "e2e": "tsx --env-file-if-exists=../../.env scripts/smoke.ts && tsx --env-file-if-exists=../../.env scripts/receipt-e2e.ts && tsx --env-file-if-exists=../../.env scripts/memo-e2e.ts && tsx --env-file-if-exists=../../.env scripts/session-e2e.ts && tsx --env-file-if-exists=../../.env scripts/ringpay-e2e.ts",
    "receipt:demo": "tsx --env-file-if-exists=../../.env scripts/receipt-demo.ts",
    "ringpay:e2e": "tsx --env-file-if-exists=../../.env scripts/ringpay-e2e.ts"
  },
  "dependencies": {
    "@heliuslabs/zolana": "0.6.0-alpha",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "^8.3.0"
  }
}
