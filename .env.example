# Network preset: localnet | devnet
ZOLANA_NETWORK=localnet

# Helius API key (devnet only).
API_KEY=

# Optional service overrides.
# ZOLANA_RPC_URL=
# ZOLANA_INDEXER_URL=
# ZOLANA_PROVER_URL=

# Devnet test runs: a funded Solana keypair that pays test wallets (the devnet
# RPC faucet is closed). Unset on localnet, where scripts airdrop instead.
# ZOLANA_FUNDER_KEYPAIR=.devnet/funder.json

# Fee payer / wallet keypair (Solana CLI JSON format).
ZOLANA_PAYER_KEYPAIR=~/.config/solana/id.json
